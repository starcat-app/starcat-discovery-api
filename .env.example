# ================================
# starcat-discovery-api .env.example
# ================================
# 复制此文件为 .env 并填实际值。
# .env 不会提交到 git。Fly.io 部署时用 `fly secrets set`。

PORT=5006
STORE_FILE=./discovery.db

# Starcat 客户端读取接口 key，逗号分隔多个值。
API_KEYS=sk-starcat-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 管理接口 key。不要与 API_KEYS 复用。
ADMIN_API_KEYS=sk-starcat-admin-XXXXXXXXXXXXXXXXXXXXXXXX

# GitHub PAT 池，逗号分隔。后端只保存服务端 PAT，不接收用户 token。
GITHUB_TOKENS=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

SYNC_ENABLED=true
SYNC_CRON=17 */3 * * *
FULL_SYNC_CRON=23 2 * * *
CACHE_TTL_SECONDS=10800
MAX_SEARCH_CALLS_PER_MINUTE=28
RATE_LIMIT_FLOOR=50
FEED_TARGET_SIZE=500

# 仓库星标历史默认关闭。完成 GH Archive / BigQuery M0 验证并单独授权后才能启用。
STAR_HISTORY_ENABLED=false
STAR_HISTORY_CACHE_TTL_SECONDS=86400
STAR_HISTORY_NEGATIVE_TTL_SECONDS=600
STAR_HISTORY_BUILD_TIMEOUT_SECONDS=300
STAR_HISTORY_WORKER_CONCURRENCY=1
STAR_HISTORY_QUEUE_CAPACITY=32
STAR_HISTORY_MAX_POINTS=500

# STAR_HISTORY_ENABLED=true 时必填。凭据 JSON 只能通过服务端 secret 注入；
# 留空时使用 ADC。单次与每日预算必须由 M0 明确后填写，示例文件不提供猜测值。
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
BIGQUERY_MAX_BYTES_BILLED=
STAR_HISTORY_DAILY_MAX_BYTES_BILLED=
